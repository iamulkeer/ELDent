# Verilənlər bazası (docker-compose daxilində host "db" olur)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eldent_db

# JWT imza açarı — istehsalda mütləq dəyişin (uzun təsadüfi mətn)
SECRET_KEY=change-me-to-a-long-random-string

# İlk admin hesabı (yalnız yoxdursa yaradılır)
ADMIN_EMAIL=admin@eldent.az
ADMIN_PASSWORD=admin123

# İş saatları (randevu qaydaları)
WORK_START_HOUR=9
WORK_END_HOUR=18
